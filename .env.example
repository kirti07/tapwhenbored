# Supabase project used by the Bubble Tap and Honeycomb leaderboards.
# Copy to .env.local and fill in from Supabase: Project Settings -> API.
#
# Only VITE_-prefixed variables are exposed to client code. The anon key is
# public by design — row-level security protects the table, and every write
# goes through a security-definer RPC (see README-supabase.sql).
#
# Both may be left empty: the games play normally and their leaderboards
# simply report as unavailable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
